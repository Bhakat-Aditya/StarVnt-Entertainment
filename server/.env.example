# StarVnt Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Get this from MongoDB Atlas → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/starvnt?retryWrites=true&w=majority

# ── JWT ────────────────────────────────────────────────────────────────────────
# Use a long, random string. Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────────────────────────────
# Your Vercel frontend URL (no trailing slash)
CLIENT_URL=https://starvnt-entertainment.vercel.app

# ── Server ─────────────────────────────────────────────────────────────────────
# Render sets PORT automatically. Only override locally if needed.
PORT=5000
