# StarVnt Client Environment Variables
# For local development, Vite proxies /api to http://localhost:5000 automatically.
# However, when deploying to Vercel, you need to provide the full URL to your Render backend.

# Set this in your Vercel Project Settings -> Environment Variables
# Example: VITE_API_URL=https://starvnt-api.onrender.com/api
VITE_API_URL=
