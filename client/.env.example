# StarVnt Client — Environment Variables
# Copy this file to .env and fill in your values.
# In local dev, leave VITE_API_URL empty — Vite's proxy handles /api → localhost:5000.
# In production (Vercel), set VITE_API_URL to your Render backend URL.

# ── API URL ────────────────────────────────────────────────────────────────────
# Leave empty for local dev (Vite proxy handles it).
# Set to your full Render URL for production:
# VITE_API_URL=https://your-app-name.onrender.com/api
VITE_API_URL=
